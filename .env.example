# =========================================================
#  Task Scheduler System - biến môi trường cho docker-compose
#
#  Cách dùng:
#    1. Copy file này thành `.env` (cùng thư mục với docker-compose.yml)
#    2. Điền giá trị thật vào
#    3. KHÔNG bao giờ commit file `.env` lên git (đã bị ignore)
# =========================================================

# ----- PostgreSQL -----
# Mật khẩu của user 'postgres' mà service API kết nối tới.
DB_PASSWORD=doi-thanh-mat-khau-man-cua-ban

# ----- JWT -----
# Chuỗi dùng để ký JWT. BẮT BUỘC dài >= 32 ký tự (HMAC-SHA256).
# Tạo nhanh một chuỗi ngẫu nhiên:  openssl rand -base64 48
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-rat-dai-toi-thieu-32-ky-tu

# ----- SMTP (gửi email cảnh báo khi task lỗi) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ban@gmail.com
SMTP_PASSWORD=app-password-cua-ban

# ----- Thông báo -----
# Địa chỉ email nhận cảnh báo khi task chạy thất bại.
NOTIFICATIONS_ADMIN_EMAIL=admin@congty.com
